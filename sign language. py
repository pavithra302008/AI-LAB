import cv2
import mediapipe as mp
import pyttsx3
import time
voice = pyttsx3.init()
voice.setProperty("rate", 150)
hands = mp.solutions.hands.Hands(
 max_num_hands=1,
 min_detection_confidence=0.7,
 min_tracking_confidence=0.7
)
draw = mp.solutions.drawing_utils
cam = cv2.VideoCapture(0)
last_sign, last_time = "", 0
while True:
 ok, frame = cam.read()
 if not ok:
 break
 frame = cv2.flip(frame, 1)
 result = hands.process(cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
 sign = "No Hand" if result.multi_hand_landmarks:
 hand = result.multi_hand_landmarks[0]
 draw.draw_landmarks(frame, hand, mp.solutions.hands.HAND_CONNECTIONS)
 f = [
 hand.landmark[4].x > hand.landmark[3].x,
 hand.landmark[8].y < hand.landmark[6].y,
 hand.landmark[12].y < hand.landmark[10].y,
 hand.landmark[16].y < hand.landmark[14].y,
 hand.landmark[20].y < hand.landmark[18].y
 ]
 count = sum(f)
 if count == 5:
 sign = "HELLO"
 elif count == 0:
 sign = "STOP"
 elif f[1] and f[2] and not f[3] and not f[4]:
 sign = "PEACE"
 elif f[1] and not f[2] and not f[3] and not f[4]:
 sign = "ONE"
 elif f[0] and count == 1:
 sign = "YES"
 else:
 sign = "UNKNOWN"
 now = time.time() if sign not in ("UNKNOWN", "No Hand") and sign != last_sign and now-last_time 
> 2:
 print("Detected:", sign)
 voice.say(sign)
 voice.runAndWait()
 last_sign, last_time = sign, now
 cv2.putText(frame, "SIGN: " + sign, (25,60),
 cv2.FONT_HERSHEY_SIMPLEX, 1, (0,255,0), 2)
 cv2.putText(frame, "Press Q to Exit", (20,450),
 cv2.FONT_HERSHEY_SIMPLEX, .7, (255,255,255), 2)
 cv2.imshow("AI Sign Language Recognition", frame)
 if cv2.waitKey(1) & 0xFF == ord("q"):
 break
cam.release()
cv2.destroyAllWindows()
hands.close()
voice.stop()